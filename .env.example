# MySQL Database Configuration (Required)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=hir_industries
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Storage Configuration (Required)
# Absolute path to storage directory on the server filesystem
STORAGE_BASE_PATH=/var/www/storage

# Admin Authentication (Optional - currently uses hardcoded token)
# ADMIN_TOKEN will be implemented in future auth migration

# Build Configuration (Optional)
NODE_ENV=production
