# ========================================
# HIR Industries - Environment Configuration
# ========================================
#
# IMPORTANT: This is a template file with placeholders.
# DO NOT commit actual credentials to Git.
#
# LOCAL DEVELOPMENT:
# Copy this file to .env and set your local XAMPP values.
#
# PRODUCTION (Hostinger):
# Set these variables in Hostinger's Node.js App environment panel.
# DO NOT use .env file in production.
# ========================================

# MySQL Database Configuration
DATABASE_HOST=your-database-host
DATABASE_PORT=3306
DATABASE_NAME=your-database-name
DATABASE_USER=your-database-user
DATABASE_PASSWORD=your-database-password

# Storage Configuration
STORAGE_BASE_PATH=/path/to/storage

# NODE_ENV
NODE_ENV=production