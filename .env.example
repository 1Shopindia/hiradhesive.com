# ========================================
# HIR Industries - Environment Configuration
# ========================================
# 
# IMPORTANT: This is a template file with placeholders.
# DO NOT commit actual credentials to Git.
# 
# LOCAL DEVELOPMENT:
# Copy this file to .env and set your local XAMPP values
# 
# PRODUCTION (Hostinger):
# Set these variables in Hostinger's Node.js App environment panel
# DO NOT use .env file in production
# ========================================

# MySQL Database Configuration (Required)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=hir_industries
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password

# Storage Configuration (Required)
# Local: /Applications/XAMPP/xamppfiles/htdocs/hir-hub-main 2/public/storage
# Production: /home/u860840011/domains/hiradhesive.com/public_html/uploads
STORAGE_BASE_PATH=/path/to/storage

# ========================================
# HOSTINGER PRODUCTION VALUES (Example)
# Set these in Hostinger Node.js App Panel:
# ========================================
